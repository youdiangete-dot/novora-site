{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx --yes npm@11.13.0 ci",
  "buildCommand": "npx --yes npm@11.13.0 run build",
  "git": {
    "deploymentEnabled": {
      "codex/m2-protected-runtime-proof-v1": false,
      "codex/m2-stage-c-r3-runtime-flags": false
    }
  },
  "functions": {
    "app/api/queues/first-preview-generation/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "novora-first-preview-generation-v1"
        }
      ]
    }
  }
}
